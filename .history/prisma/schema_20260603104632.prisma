generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignedJobs  Job[]          @relation("EngineerJobs")
  jobActivities JobActivity[]
  notifications Notification[]
  partRequests  PartRequest[]
  tallyDocuments TallyDocument[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String?  @db.VarChar(254)
  devices   Device[]
  jobs      Job[]
}

model Device {
  id         String   @id @default(uuid())
  customerId String
  type       String
  brand      String
  model      String
  serialNo   String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs       Job[]

  @@index([customerId])
}

model Job {
  id            String        @id @default(uuid())
  customerId    String
  deviceId      String
  engineerId    String?
  problemDesc   String
  status        String        @default("New")
  estimatedCost Float?
  actualCost    Float?
  repairNotes   String?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  checklist     Json?
  feedback      String?
  linkedJobId   String?
  rating        Int?
  advanceAmount Float?        @default(0)
  invoiceNumber String?       @unique
  paymentMethod String?
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  device        Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  engineer      User?         @relation("EngineerJobs", fields: [engineerId], references: [id])
  linkedJob     Job?          @relation("JobWarranty", fields: [linkedJobId], references: [id])
  warrantyJobs  Job[]         @relation("JobWarranty")
  activities    JobActivity[]
  photos        JobPhoto[]
  partRequests  PartRequest[]
  payment       Payment?

  @@index([customerId])
  @@index([deviceId])
  @@index([engineerId])
  @@index([status])
  @@index([linkedJobId])
}

model JobActivity {
  id        String   @id @default(uuid())
  jobId     String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([userId])
}

model JobPhoto {
  id        String   @id @default(uuid())
  jobId     String
  url       String
  type      String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model PartRequest {
  id         String    @id @default(uuid())
  jobId      String
  engineerId String
  partName   String
  quantity   Int
  reason     String
  status     String    @default("Pending")
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  unitCost   Float?
  engineer   User      @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([engineerId])
}

model Payment {
  id            String   @id @default(uuid())
  jobId         String   @unique
  serviceCharge Float    @default(0)
  partsCost     Float    @default(0)
  totalBill     Float    @default(0)
  status        String   @default("Unpaid")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  category    String
  quantity    Int      @default(0)
  minQuantity Int      @default(5)
  unitPrice   Float
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  jobId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
}

model Session {
  token     String   @id @db.VarChar(64)
  userId    String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  idleAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SLAConfig {
  id        String   @id @default("sla-config")
  tiers     Json
  updatedAt DateTime @updatedAt
}

model WarrantyConfig {
  id        String   @id @default("warranty-config")
  entries   Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  userId    String
  userName  String
  userRole  String
  action    String
  entity    String
  entityId  String?
  field     String?
  oldValue  String?
  newValue  String?
  meta      String?

  @@index([timestamp(sort: Desc)])
  @@index([entity, entityId])
  @@index([userId])
}

model Webhook {
  id        String   @id @default(uuid())
  name      String
  url       String
  secret    String?
  events    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id          String     @id @default(uuid())
  saleNumber  String     @unique
  customerId  String?
  companyName String
  contactName String
  phone       String
  notes       String?
  totalAmount Float      @default(0)
  paidAt      DateTime?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       SaleItem[]

  @@index([createdAt(sort: Desc)])
  @@index([customerId])
}

model SaleItem {
  id              String @id @default(uuid())
  saleId          String
  inventoryItemId String
  itemName        String
  quantity        Int
  unitPrice       Float
  subtotal        Float
  sale            Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model TallySyncSetting {
  id                    String   @id @default("tally-sync-settings")
  enabled               Boolean  @default(false)
  host                  String   @default("localhost")
  port                  Int      @default(9000)
  companyName           String   @default("")
  syncStatus            String   @default("idle")
  mockMode              Boolean  @default(false)
  autoPushOnApproval    Boolean  @default(true)
  lastTestedAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model TallyLedger {
  id          String   @id @default(uuid())
  name        String
  mappedName  String
  source      String
  type        String
  confidence  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TallyStockItem {
  id          String   @id @default(uuid())
  itemName    String
  inventoryId String?
  mappedName  String
  confidence  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TallyDocument {
  id            String   @id @default(uuid())
  fileName      String
  documentType  String
  extractedData Json
  mappedLedger  Json?
  mappedStock   Json?
  voucherType   String
  confidence    Float    @default(0)
  status        String   @default("pending")
  xmlPayload    String?
  tallyResponse String?
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}
