generator client {
  provider = "prisma-client-js"
  }

datasource db {
  provider = "postgresql"
}

// ── User Management ───────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // "admin" | "reception" | "engineer"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedJobs  Job[]          @relation("EngineerJobs")
  partRequests  PartRequest[]
  notifications Notification[]
  jobActivities JobActivity[]
}

// ── Customer Management ───────────────────────────────────────────
model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String? @db.VarChar(254)
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs    Job[]
  devices Device[]
}

// ── Device Details ────────────────────────────────────────────────
model Device {
  id         String   @id @default(uuid())
  customerId String
  type       String
  brand      String
  model      String
  serialNo   String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  jobs     Job[]
}

// ── Job Workflow ──────────────────────────────────────────────────
model Job {
  id            String    @id @default(uuid())
  customerId    String
  deviceId      String
  engineerId    String?
  problemDesc   String
  status        String    @default("New")
  estimatedCost Float?
  actualCost    Float?
  repairNotes   String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  device       Device        @relation(fields: [deviceId], references: [id])
  engineer     User?         @relation("EngineerJobs", fields: [engineerId], references: [id])
  partRequests PartRequest[]
  payment      Payment?

  checklist    Json?
  rating       Int?
  feedback     String?
  linkedJobId  String?
  linkedJob    Job?          @relation("JobWarranty", fields: [linkedJobId], references: [id])
  warrantyJobs Job[]         @relation("JobWarranty")
  activities   JobActivity[]
  photos       JobPhoto[]
  import React, { useState, useRef } from 'react';
