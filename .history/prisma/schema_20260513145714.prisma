  const paymentBorder = job.status === 'Delivered' ? '#bbf7d0' : '#fde68a';

  const partsRows = approvedParts.map((pr: any) => {
    const inv = inventory.find((i: any) => i.name.toLowerCase() === pr.partName.toLowerCase());
