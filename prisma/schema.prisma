generator client {
  provider = "prisma-client-js"
  }

datasource db {
  provider = "postgresql"
}

// ── User Management ───────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // "admin" | "reception" | "engineer"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedJobs  Job[]          @relation("EngineerJobs")
  partRequests  PartRequest[]
  notifications Notification[]
}

// ── Customer Management ───────────────────────────────────────────
model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs    Job[]
  devices Device[]
}

// ── Device Details ────────────────────────────────────────────────
model Device {
  id         String   @id @default(uuid())
  customerId String
  type       String
  brand      String
  model      String
  serialNo   String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  jobs     Job[]
}

// ── Job Workflow ──────────────────────────────────────────────────
model Job {
  id            String    @id @default(uuid())
  customerId    String
  deviceId      String
  engineerId    String?
  problemDesc   String
  status        String    @default("New")
  estimatedCost Float?
  actualCost    Float?
  repairNotes   String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  device       Device        @relation(fields: [deviceId], references: [id])
  engineer     User?         @relation("EngineerJobs", fields: [engineerId], references: [id])
  partRequests PartRequest[]
  payment      Payment?
}

// ── Parts Request System ──────────────────────────────────────────
model PartRequest {
  id         String    @id @default(uuid())
  jobId      String
  engineerId String
  partName   String
  quantity   Int
  reason     String
  status     String    @default("Pending")
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  job      Job  @relation(fields: [jobId], references: [id])
  engineer User @relation(fields: [engineerId], references: [id])
}

// ── Revenue & Billing ─────────────────────────────────────────────
model Payment {
  id            String   @id @default(uuid())
  jobId         String   @unique
  serviceCharge Float    @default(0)
  partsCost     Float    @default(0)
  totalBill     Float    @default(0)
  status        String   @default("Unpaid")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id])
}

// ── Inventory ─────────────────────────────────────────────────────
model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  category    String
  quantity    Int      @default(0)
  minQuantity Int      @default(5)
  unitPrice   Float
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Notifications ─────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  jobId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Session {
  token     String   @id @db.VarChar(64)
  userId    String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}