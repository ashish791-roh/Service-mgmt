generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branchId      String         @default("default")
  assignedJobs  Job[]          @relation("EngineerJobs")
  jobActivities JobActivity[]
  notifications Notification[]
  partRequests  PartRequest[]
  tallyDocuments TallyDocument[]

  @@index([branchId])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String?  @db.VarChar(254)
  gstin     String?
  branchId  String   @default("default")
  devices   Device[]
  jobs      Job[]

  @@index([branchId])
}

model Device {
  id         String   @id @default(uuid())
  customerId String
  type       String
  brand      String
  model      String
  serialNo   String?
  createdAt  DateTime @default(now())
  branchId   String   @default("default")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs       Job[]

  @@index([customerId])
  @@index([branchId])
}

model Job {
  id            String        @id @default(uuid())
  customerId    String
  deviceId      String
  engineerId    String?
  problemDesc   String
  status        String        @default("New")
  estimatedCost Float?
  actualCost    Float?
  repairNotes   String?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  checklist     Json?
  feedback      String?
  linkedJobId   String?
  rating        Int?
  advanceAmount Float?        @default(0)
  invoiceNumber String?       @unique
  paymentMethod String?
  branchId      String        @default("default")
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  device        Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  engineer      User?         @relation("EngineerJobs", fields: [engineerId], references: [id])
  linkedJob     Job?          @relation("JobWarranty", fields: [linkedJobId], references: [id])
  warrantyJobs  Job[]         @relation("JobWarranty")
  activities    JobActivity[]
  photos        JobPhoto[]
  partRequests  PartRequest[]
  payment       Payment?

  @@index([customerId])
  @@index([deviceId])
  @@index([engineerId])
  @@index([status])
  @@index([linkedJobId])
  @@index([branchId])
}

model JobActivity {
  id        String   @id @default(uuid())
  jobId     String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  branchId  String   @default("default")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([userId])
  @@index([branchId])
}

model JobPhoto {
  id        String   @id @default(uuid())
  jobId     String
  url       String
  type      String
  createdAt DateTime @default(now())
  branchId  String   @default("default")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([branchId])
}

model PartRequest {
  id         String    @id @default(uuid())
  jobId      String
  engineerId String
  partName   String
  quantity   Int
  reason     String
  status     String    @default("Pending")
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  unitCost   Float?
  branchId   String    @default("default")
  engineer   User      @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([engineerId])
  @@index([branchId])
}

model Payment {
  id            String   @id @default(uuid())
  jobId         String   @unique
  serviceCharge Float    @default(0)
  partsCost     Float    @default(0)
  totalBill     Float    @default(0)
  status        String   @default("Unpaid")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branchId      String   @default("default")
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([branchId])
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  category    String
  quantity    Int      @default(0)
  minQuantity Int      @default(5)
  unitPrice   Float
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branchId    String   @default("default")

  @@index([branchId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  jobId     String?
  createdAt DateTime @default(now())
  branchId  String   @default("default")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@index([branchId])
}

model Session {
  token     String   @id @db.VarChar(64)
  userId    String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  idleAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SLAConfig {
  id        String   @id @default("sla-config")
  tiers     Json
  updatedAt DateTime @updatedAt
}

model WarrantyConfig {
  id        String   @id @default("warranty-config")
  entries   Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  userId    String
  userName  String
  userRole  String
  action    String
  entity    String
  entityId  String?
  field     String?
  oldValue  String?
  newValue  String?
  meta      String?

  @@index([timestamp(sort: Desc)])
  @@index([entity, entityId])
  @@index([userId])
}

model Webhook {
  id        String   @id @default(uuid())
  name      String
  url       String
  secret    String?
  events    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id          String     @id @default(uuid())
  saleNumber  String     @unique
  customerId  String?
  companyName String
  contactName String
  phone       String
  notes       String?
  totalAmount Float      @default(0)
  paidAt      DateTime?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  branchId    String     @default("default")
  items       SaleItem[]

  @@index([createdAt(sort: Desc)])
  @@index([customerId])
  @@index([branchId])
}

model SaleItem {
  id              String @id @default(uuid())
  saleId          String
  inventoryItemId String
  itemName        String
  quantity        Int
  unitPrice       Float
  subtotal        Float
  branchId        String @default("default")
  sale            Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([branchId])
}

model TallySyncSetting {
  id                    String   @id @default("tally-sync-settings")
  enabled               Boolean  @default(false)
  host                  String   @default("localhost")
  port                  Int      @default(9000)
  companyName           String   @default("")
  syncStatus            String   @default("idle")
  mockMode              Boolean  @default(false)
  autoPushOnApproval    Boolean  @default(true)
  lastTestedAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model TallyLedger {
  id          String   @id @default(uuid())
  name        String
  mappedName  String
  source      String
  type        String
  confidence  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TallyStockItem {
  id          String   @id @default(uuid())
  itemName    String
  inventoryId String?
  mappedName  String
  confidence  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TallyDocument {
  id            String   @id @default(uuid())
  fileName      String
  documentType  String
  extractedData Json
  mappedLedger  Json?
  mappedStock   Json?
  voucherType   String
  confidence    Float    @default(0)
  status        String   @default("pending")
  xmlPayload    String?
  tallyResponse String?
  ownerId       String
  retryCount    Int      @default(0)
  nextRetryAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model BusinessSettings {
  id        String   @id @default("business-settings")
  shopName  String   @default("FixHub")
  tagline   String   @default("Device Repair & Service Centre")
  address   String   @default("123 Main Street, Sector 5, Bangalore, Karnataka - 560001")
  phone     String   @default("+91 98765 43210")
  email     String   @default("support@fixhub.com")
  gstin     String   @default("29ABCDE1234F1Z5")
  taxRate   Float    @default(18)
  taxLabel  String   @default("GST")
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  gstin     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branchId  String   @default("default")

  @@index([branchId])
}

model Expense {
  id            String   @id @default(uuid())
  description   String
  amount        Float
  category      String
  paymentMethod String
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branchId      String   @default("default")

  @@index([branchId])
}

model Purchase {
  id             String         @id @default(uuid())
  purchaseNumber String         @unique
  supplierId     String?
  supplierName   String
  totalAmount    Float          @default(0)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  branchId       String         @default("default")
  items          PurchaseItem[]

  @@index([branchId])
}

model PurchaseItem {
  id              String   @id @default(uuid())
  purchaseId      String
  inventoryItemId String
  itemName        String
  quantity        Int
  unitPrice       Float
  subtotal        Float
  branchId        String   @default("default")
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([branchId])
}

model TallyQueueItem {
  id            String    @id @default(uuid())
  entityType    String    // 'job', 'sale', 'customer', 'payment', 'inventory', 'expense', 'supplier', 'purchase', 'warranty_claim', 'ocr_document'
  entityId      String
  actionType    String    // 'sync_invoice', 'sync_ledger', 'sync_receipt', 'sync_stock', 'sync_expense', 'sync_purchase', 'sync_warranty'
  status        String    @default("pending") // 'pending', 'processing', 'completed', 'failed', 'retrying', 'cancelled'
  priority      Int       @default(0) // 0 = normal, 1 = high
  retryCount    Int       @default(0)
  maxRetries    Int       @default(5)
  errorMessage  String?
  xmlPayload    String?
  tallyResponse String?
  nextRetryAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  metadata      Json?
  branchId      String    @default("default")

  @@index([status])
  @@index([nextRetryAt])
  @@index([entityType, entityId])
  @@index([branchId])
}

model Branch {
  id        String    @id
  name      String
  apiKey    String    @unique
  suspended Boolean   @default(false)
  lastSeen  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SyncOutbox {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  payload    Json
  seq        BigInt   @default(autoincrement())
  createdAt  DateTime @default(now())
  processed  Boolean  @default(false)

  @@index([processed, seq])
  @@index([entityType, entityId])
}

model SyncOutboxLedger {
  id        String   @id @default(uuid())
  branchId  String   @unique
  lastSeq   BigInt
  updatedAt DateTime @updatedAt
}

model ConfigDirective {
  id            String   @id @default(uuid())
  directiveType String
  payload       Json
  seq           BigInt   @default(autoincrement())
  createdAt     DateTime @default(now())

  @@index([seq])
}

model ConfigSyncState {
  id        String   @id @default("config-sync-state")
  lastSeq   BigInt
  updatedAt DateTime @updatedAt
}
