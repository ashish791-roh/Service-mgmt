# Database
DATABASE_URL="postgresql://username:password@localhost:5432/fixhub"

# Deployment Configuration
# 'hq' for central deployment, 'branch' for individual physical shop deployments
DEPLOYMENT_ROLE=branch

# Branch Configuration (Required only if DEPLOYMENT_ROLE=branch)
BRANCH_ID=default
BRANCH_API_KEY=default-branch-api-key
HQ_BASE_URL=http://localhost:3000
